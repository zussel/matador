<!DOCTYPE html>
<html lang="en">
{% include "../templates/header.matador" %}
<body>
<header class="container">
    <h1>{{title}}</h1>
</header>
<main class="container">
    <nav aria-label="breadcrumb">
        <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/movie">{{title}}</a></li>
            <li>Edit Movie</li>
        </ul>
    </nav>

    <a role="button" href="/movie/{{movie.id}}">Back</a>

    <form action="/api/movie/{{movie.id}}" method="post">
        <fieldset class="grid">
            <label for="aligned-id">Id</label>
            <input type="text" id="aligned-id" placeholder="Id" readonly="" name="id" value="{{movie.id}}"/>
        </fieldset>
        <fieldset class="grid">
            <label for="aligned-name">Name</label>
            <input type="text" id="aligned-name" placeholder="Title" name="name" value="{{movie.title}}" />
        </fieldset>
        <fieldset class="grid">
            <label for="aligned-director">Director</label>
            <select id="aligned-director" name="director">
                {% for director in directors %}
                <option value="{{director.id}}">{% if director.id == forloop.parent.movie.director.id %}selected{% endif %}{{director.name}}</option>
                {% endfor %}
            </select>
        </fieldset>
        <fieldset class="grid">
            <label for="aligned-year">Year</label>
            <input type="number" id="aligned-year" placeholder="Year" name="year" value="{{movie.year}}" />
        </fieldset>
        <fieldset class="grid">
            <input type="submit" value="Update"/>
            <input type="reset" onclick="location.href='/movie/{{movie.id}}'"/>
        </fieldset>
    </form>
</main>
</body>
</html>