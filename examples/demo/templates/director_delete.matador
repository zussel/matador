<!DOCTYPE html>
<html lang="en">
{% include "../templates/header.matador" %}
<body>
    <header class="container">
        <h1>{{title}}</h1>
    </header>
    <main class="container">
        <nav aria-label="breadcrumb">
            <ul>
                <li><a href="/">Home</a></li>
                <li><a href="/director">Directors</a></li>
                <li>Delete {{director.name | escape}}</li>
            </ul>
        </nav>

        <form>
            <label>Do you really want to delete the director?</label>
            <fieldset class="grid">
                <label for="aligned-id">Id</label>
                <input type="text" id="aligned-id" placeholder="Id" readonly="" name="id" value="{{director.id}}"/>
            </fieldset>
            <fieldset class="grid">
                <label for="aligned-name">Name</label>
                <input type="text" id="aligned-name" placeholder="Name" readonly="" name="name" value="{{director.name | escape}}"/>
            </fieldset>
            <fieldset class="grid">
                <label for="aligned-date">Date of Birth</label>
                <input type="date" id="aligned-date" aria-label="Date"  readonly="" placeholder="Date of Birth" name="birthday" value="{{director.birthday}}"/>
            </fieldset>
            <fieldset class="grid">
                <input type="submit" value="Delete"/>
                <input type="reset" value="Cancel" onclick="location.href='/director'"/>
            </fieldset>
        </form>
    </main>
</body>
</html>