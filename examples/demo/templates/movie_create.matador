<!DOCTYPE html>
<html lang="en">
{% include "../templates/header.matador" %}
<body>
<header class="container">
    <h1>{{title}}</h1>
</header>
<main class="container">
    <nav aria-label="breadcrumb">
        <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/movie">{{title}</a></li>
            <li>Create Movie</li>
        </ul>
    </nav>
    <form action="/api/movie" method="post">
        <fieldset class="grid">
            <label for="aligned-id">Id</label>
            <input type="text" id="aligned-id" placeholder="Id" readonly="" name="id"/>
        </fieldset>
        <fieldset class="grid">
            <label for="aligned-name">Name</label>
            <input type="text" id="aligned-name" placeholder="Title" name="name"/>
        </fieldset>
        <fieldset class="grid">
            <label for="aligned-director">Director</label>
            <select id="aligned-director" name="director">
                {% for director in directors %}
                <option value="{{director.id}}">{{director.name}}</option>
                {% endfor %}
            </select>
        </fieldset>
        <fieldset class="grid">
            <label for="aligned-year">Year</label>
            <input type="number" id="aligned-year" placeholder="Year" name="year"/>
        </fieldset>
        <fieldset class="grid">
            <input type="submit" value="Submit"/>
            <input type="reset" onclick="location.href='/movie'"/>
        </fieldset>
    </form>
</main>
</body>
</html>