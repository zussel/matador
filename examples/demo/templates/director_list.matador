<!DOCTYPE html>
<html lang="en">
{% include "../templates/header.matador" %}
<body>
    <header class="container">
        <h1>{{title}}</h1>
    </header>
    <main class="container">
        <nav aria-label="breadcrumb">
            <ul>
                <li><a href="/">Home</a></li>
                <li>Directors</li>
            </ul>
        </nav>

        <button class="outline"><a href="/director/create">Create</a></button>

        <table class="striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Date of birth</th>
                </tr>
            </thead>
            <tbody>
                {% for director in directorlist %}
                <tr>
                    <td><a href="/director/{{director.id}}">{{ director.id }}</a></td>
                    <td><a href="/director/{{director.id}}">{{ director.name }}</a></td>
                    <td>{{ director.birthday }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </main>
</body>
</html>