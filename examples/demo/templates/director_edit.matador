<!DOCTYPE html>
<html lang="en">
{% include "../templates/header.matador" %}
<body>
    <header class="container">
        <h1>{{title}}</h1>
    </header>
    <main class="container">
        <nav aria-label="breadcrumb">
            <ul>
                <li><a href="/">Home</a></li>
                <li><a href="/director">Directors</a></li>
                <li>Create Director</li>
            </ul>
        </nav>
        <form action="/api/director/{{director.id}}" method="post">
            <fieldset class="grid">
                <label for="aligned-id">Id</label>
                <input type="text" id="aligned-id" placeholder="Id" readonly="" name="id" value="{{director.id}}"/>
            </fieldset>
            <fieldset class="grid">
                <label for="aligned-name">Name</label>
                <input type="text" id="aligned-name" placeholder="Name" name="name" value="{{director.name}}" />
            </fieldset>
            <fieldset class="grid">
                <label for="aligned-date">Date of Birth</label>
                <input type="date" id="aligned-date" aria-label="Date" placeholder="Date of Birth" name="birthday" value="{{director.birthday}}"/>
            </fieldset>
            <fieldset class="grid">
                <input type="submit" value="Update"/>
                <input type="reset" onclick="location.href='/director'"/>
            </fieldset>
        </form>
    </main>
</body>
</html>